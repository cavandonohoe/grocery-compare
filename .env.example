# Postgres connection string. Required for any database access
# (the app throws if it is missing when the database is queried).
DATABASE_URL="postgres://user:password@localhost:5432/grocery_compare"

# OpenAI API key. Optional. When unset, product matching falls back to
# term-overlap matching instead of calling OpenAI.
OPENAI_API_KEY=""

# OpenAI model used for product matching. Optional. Defaults to gpt-5-mini
# when unset. Only used when OPENAI_API_KEY is set.
OPENAI_MATCH_MODEL="gpt-5-mini"

# Vons (Albertsons) live pricing. Optional. When unset, the Vons adapter
# falls back to mock data. The pdpdata API is gated by Imperva/Incapsula bot
# protection, so these must be captured from a logged-in browser session and
# refreshed when price lookups start returning 403 (roughly daily).
#
# Capture: open a Vons product page with a store set, DevTools > Network >
# the `pdpdata` request > Copy the `ocp-apim-subscription-key` header and the
# full `Cookie` header. VONS_STORE_ID is the numeric store a ZIP resolves to
# (visible as `storeId` in the same response; defaults to 2002).
VONS_SUBSCRIPTION_KEY=""
VONS_COOKIES=""
VONS_STORE_ID="2002"
